# ============================================================
# SYSTEM Y'IBANZE - Environment Variables
# Kopi iyi dosiye nka .env hanyuma uzuze amakuru
# ============================================================

# ── Server ──────────────────────────────────────────────────
PORT=5000
NODE_ENV=development
# NODE_ENV=production  ← Hindura mu bikorwa nyakuri

# ── Database (MySQL) ─────────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_strong_db_password_here
DB_NAME=system_yibanze
DB_CONNECTION_LIMIT=10

# ── JWT Secrets ──────────────────────────────────────────────
# IMPORTANT: Hindura ibi mu bikorwa nyakuri (nibura imibare 64)
# Gukora: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=CHANGE_THIS_TO_A_RANDOM_64_CHAR_STRING_IN_PRODUCTION
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=CHANGE_THIS_TO_ANOTHER_RANDOM_64_CHAR_STRING
JWT_REFRESH_EXPIRES_IN=7d

# ── NIDA API (Rwanda National ID Authority) ──────────────────
# Bona API key kuri: https://www.nida.gov.rw
NIDA_API_URL=https://www.nida.gov.rw/api/v1
NIDA_API_KEY=your_nida_api_key_here
NIDA_API_SECRET=your_nida_api_secret_here
# Mu iterambere (development), simulation ikoreshwa

# ── File Upload ──────────────────────────────────────────────
UPLOAD_PATH=./uploads
MAX_FILE_SIZE=5242880
# 5MB = 5 * 1024 * 1024

# ── CORS (Frontend URLs) ─────────────────────────────────────
# Shyiramo URLs zose zemezwa (zitandukanywa na comma)
FRONTEND_URL=http://localhost:3000
# Mu production:
# FRONTEND_URL=https://system-yibanze.gov.rw,https://www.system-yibanze.gov.rw

# ── Rate Limiting ────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=5
NIDA_RATE_LIMIT_MAX=10

# ── Logging ──────────────────────────────────────────────────
LOG_LEVEL=info
# Mu production: combined | Mu development: dev
